import pandas as pd
import numpy as np
from pathlib import Path

fp = Path(r'C:\Users\tarun\AppData\Local\Programs\Python\Python313\Data.xlsx')
df = pd.read_excel(fp, sheet_name=3)
feat_vecs = df.select_dtypes(include=[np.number]).to_numpy()
vector1 = feat_vecs[0]
vector2 = feat_vecs[1]

def minkowski_distance(point1, point2, p):
    if len(point1) != len(point2):
        raise ValueError("Feature vectors must have the same length.")
    distance = 0
    for x, y in zip(point1, point2):
        distance += abs(x - y) ** p
    return distance ** (1 / p)

def distance(point1, point2):
    distances = []
    for p in range(1, 11):
        distances.append(minkowski_distance(point1, point2, p))
    return distances

def compare_minkowski(point1, point2):
    comparison = []
    for p in range(1, 11):
        mink_distance = minkowski_distance(point1, point2, p)
        comparison.append({"p": p, "My Distance": mink_distance})
    return comparison

def dot_product(vector1, vector2):
    if len(vector1) != len(vector2):
        raise ValueError("Vectors must have the same dimensions.")
    result = 0
    for x, y in zip(vector1, vector2):
        result += x * y
    return result

def euclidean_norm(vector):
    sum_= 0
    for value in vector:
        sum_ += value ** 2
    return sum_ ** 0.5

def compare_vectors(vector1, vector2):
    results = {
        "User Dot Product": dot_product(vector1, vector2),
        "NumPy Dot Product": np.dot(vector1, vector2),
        "User Norm (A)": euclidean_norm(vector1),
        "NumPy Norm (A)": np.linalg.norm(vector1),
        "User Norm (B)": euclidean_norm(vector2),
        "NumPy Norm (B)": np.linalg.norm(vector2)
    }
    return results

def mean(data):
    total = 0
    for value in data:
        total += value
    return total / len(data)

def variance(data):
    avg = mean(data)
    variance = 0
    for value in data:
        variance += (value - avg) ** 2
    return variance / len(data)

def std(data):
    return variance(data) ** 0.5

def dataset_statistics(matrix):
    mean_vector = []
    variance_vector = []
    std_vector = []
    for i in range(matrix.shape[1]):
        column = matrix[:, i]
        mean_vector.append(mean(column))
        variance_vector.append(variance(column))
        std_vector.append(std(column))
    return (
        np.array(mean_vector),
        np.array(variance_vector),
        np.array(std_vector)
    )

def numpy_statistics(feat_vecs):
    mean_vector = feat_vecs.mean(axis=0)
    std_vector = feat_vecs.std(axis=0)
    return mean_vector, std_vector

