
def calculate_distance(x1,x2,metric='euclidean'):
    x1,x2=np.array(x1),np.array(x2)
    if metric=='euclidean':
        return np.sqrt(np.sum((x1-x2)**2))
    elif metric=='manhattan':
        return np.sum(np.abs(x1-x2))
    else:
        return np.sqrt(np.sum((x1-x2)**2))

def bubble_sort(arr):
    n=len(arr)
    for i in range(n):
        for j in range(0,n-i-1):
            if arr[j][0]>arr[j+1][0]:
                arr[j],arr[j+1]=arr[j+1],arr[j]
    return arr

def quick_sort(arr):
    if len(arr)<=1:
        return arr
    pivot=arr[len(arr)//2][0]
    left=[x for x in arr if x[0]<pivot]
    middle=[x for x in arr if x[0]==pivot]
    right=[x for x in arr if x[0]>pivot]
    return quick_sort(left)+middle+quick_sort(right)

def insertion_sort(arr):
    for i in range(1,len(arr)):
        key=arr[i]
        j=i-1
        while j>=0 and arr[j][0]>key[0]:
            arr[j+1]=arr[j]
            j-=1
        arr[j+1]=key
    return arr

def sort_distances(distances,algorithm='quick'):
    if algorithm=='bubble':
        return bubble_sort(distances)
    elif algorithm=='quick':
        return quick_sort(distances)
    elif algorithm=='insertion':
        return insertion_sort(distances)
    else:
        return quick_sort(distances)
