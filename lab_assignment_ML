words=str(input("enter the word"))
lst=[]
for word in words:
    lst.append(word.lower())
a=set(lst)
max1=0
mode=[]
for char in a:
    count=lst.count(char)
    if count>max1:
        max1=count
        mode=[char]
    elif count==max1:
        mode.append(char)
if len(mode)==1:
    print(f"The maximally occurring character is '{mode[0]}' & occurrence count is {max1}")
else:
    print(f"The maximally occurring characters are {mode} & occurrence count is {max1}")
    
    
